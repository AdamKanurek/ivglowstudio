---
import { Image } from 'astro:assets';
import portrait from '../assets/img/IVglow36.jpg';
import { site, certificates } from '../data/site';
---

<section class="section section--alt about" id="o-mne">
  <div class="container about__grid">
    <div class="about__photo reveal">
      <Image
        src={portrait}
        alt="Kosmetička IV Glow studia při ošetření pleti"
        widths={[400, 640, 960]}
        sizes="(max-width: 900px) 100vw, 45vw"
      />
    </div>

    <div class="about__text reveal">
      <span class="eyebrow">o mně</span>
      <h2 class="section-title">Kosmetika je pro mě radost</h2>
      <span class="divider about__divider"></span>
      <p class="about__lead">
        Kosmetika pro mě není jen práce, ale především radost a možnost dopřát každé ženě chvíli
        jen pro sebe.
      </p>
      <p>
        Ve svém salonu se snažím vytvářet příjemné a klidné prostředí, kde si odpočinete, načerpáte
        novou energii a zároveň se budete cítit krásně a sebevědomě.
      </p>
      <p>
        Ke každé klientce přistupuji individuálně, protože věřím, že každá pleť i každá žena má své
        vlastní potřeby.
      </p>
      <div class="about__certs">
        <h3>Vzdělání a certifikáty</h3>
        <ul>
          {
            certificates.map((c) => (
              <li>
                <span class="about__cert-title">{c.title}</span>
                <span class="about__cert-detail">
                  {c.detail} · {c.date}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
      <p class="about__sign">{site.owner}</p>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }

  .about__photo {
    position: relative;
  }

  .about__photo::before {
    content: '';
    position: absolute;
    inset: 24px -24px -24px 24px;
    border: 1px solid var(--gold-300);
  }

  .about__photo :global(img) {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 60% 30%;
  }

  .about__divider {
    margin: 20px 0 28px;
  }

  .about__lead {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.5rem;
    line-height: 1.45;
    color: var(--gold-900);
  }

  .about__certs {
    margin-top: 28px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .about__certs h3 {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold-700);
    margin-bottom: 12px;
  }

  .about__certs ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .about__certs li {
    position: relative;
    padding: 6px 0 6px 22px;
  }

  /* hvězdička z loga */
  .about__certs li::before {
    content: '✦';
    position: absolute;
    left: 0;
    top: 7px;
    font-size: 0.8rem;
    color: var(--gold-500);
  }

  .about__cert-title {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--gold-900);
    line-height: 1.3;
  }

  .about__cert-detail {
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .about__sign {
    margin: 28px 0 0;
    font-family: var(--font-script);
    font-size: 2.4rem;
    word-spacing: 0.25em;
    line-height: 1;
    color: var(--gold-500);
  }

  @media (max-width: 900px) {
    .about__grid {
      grid-template-columns: 1fr;
    }

    .about__photo {
      margin-right: 24px;
    }
  }
</style>
