---
import { Image, getImage } from 'astro:assets';
import portrait from '../assets/img/IVglow36.jpg';
import { site, certificates } from '../data/site';

// velké verze diplomů pro náhled po kliknutí
const certs = await Promise.all(
  certificates.map(async (c) => ({
    ...c,
    large: await getImage({ src: c.image, width: 1600, format: 'webp' }),
  }))
);
---

<section class="section section--alt about" id="o-mne">
  <div class="container about__grid">
    <div class="about__photo reveal">
      <Image
        src={portrait}
        alt="Kosmetička IV Glow studia při ošetření pleti"
        widths={[400, 640, 960]}
        sizes="(max-width: 900px) 100vw, 45vw"
      />
    </div>

    <div class="about__text reveal">
      <span class="eyebrow">o mně</span>
      <h2 class="section-title">Kosmetika je pro mě radost</h2>
      <span class="divider about__divider"></span>
      <p class="about__lead">
        Kosmetika pro mě není jen práce, ale především radost a možnost dopřát každé ženě chvíli
        jen pro sebe.
      </p>
      <p>
        Ve svém salonu se snažím vytvářet příjemné a klidné prostředí, kde si odpočinete, načerpáte
        novou energii a zároveň se budete cítit krásně a sebevědomě.
      </p>
      <p>
        Ke každé klientce přistupuji individuálně, protože věřím, že každá pleť i každá žena má své
        vlastní potřeby.
      </p>
      <div class="about__certs">
        <h3>Vzdělání a certifikáty</h3>
        <ul>
          {
            certs.map((c, i) => (
              <li>
                <a href={c.large.src} class="cert" data-cert={i} aria-label={`Zobrazit: ${c.title}`}>
                  <Image
                    src={c.image}
                    alt={c.alt}
                    width={120}
                    densities={[1, 2]}
                    class="cert__thumb"
                  />
                  <span class="cert__text">
                    <span class="about__cert-title">{c.title}</span>
                    <span class="about__cert-detail">
                      {c.detail} · {c.date}
                    </span>
                    <span class="cert__hint">Zobrazit certifikát</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <p class="about__sign">{site.owner}</p>
    </div>
  </div>

  <dialog class="cert-viewer" data-cert-dialog aria-label="Náhled certifikátu">
    <button class="cert-viewer__close" data-cert-close aria-label="Zavřít">×</button>
    <img class="cert-viewer__img" alt="" data-cert-img />
  </dialog>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }

  .about__photo {
    position: relative;
  }

  .about__photo::before {
    content: '';
    position: absolute;
    inset: 24px -24px -24px 24px;
    border: 1px solid var(--gold-300);
  }

  .about__photo :global(img) {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 60% 30%;
  }

  .about__divider {
    margin: 20px 0 28px;
  }

  .about__lead {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.5rem;
    line-height: 1.45;
    color: var(--gold-900);
  }

  .about__certs {
    margin-top: 28px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .about__certs h3 {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold-700);
    margin-bottom: 12px;
  }

  .about__certs ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .about__certs li + li {
    margin-top: 12px;
  }

  .cert {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 8px;
    margin: 0 -8px;
    text-decoration: none;
    cursor: zoom-in;
    transition: background-color 0.25s;
  }

  .cert:hover {
    background: rgba(255, 255, 255, 0.6);
  }

  .about__certs :global(.cert__thumb) {
    flex-shrink: 0;
    width: 120px;
    height: auto;
    aspect-ratio: 2000 / 1414;
    object-fit: cover;
    border: 4px solid #fff;
    box-shadow: 0 10px 24px -14px rgba(58, 48, 41, 0.55);
    transition: transform 0.3s;
  }

  .cert:hover :global(.cert__thumb) {
    transform: scale(1.04);
  }

  .cert__text {
    display: flex;
    flex-direction: column;
  }

  .cert__hint {
    margin-top: 4px;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    color: var(--gold-700);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--gold-300);
  }

  /* --- náhled certifikátu --- */
  .cert-viewer {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(28, 22, 18, 0.94);
  }

  .cert-viewer[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cert-viewer::backdrop {
    background: transparent;
  }

  .cert-viewer__img {
    max-width: calc(100vw - 32px);
    max-height: calc(100vh - 96px);
    object-fit: contain;
    box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.6);
  }

  .cert-viewer__close {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 48px;
    height: 48px;
    border: 0;
    background: none;
    color: #fff;
    font: 300 2.4rem/1 var(--font-sans);
    cursor: pointer;
    opacity: 0.8;
  }

  .cert-viewer__close:hover {
    opacity: 1;
  }

  .about__cert-title {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--gold-900);
    line-height: 1.3;
  }

  .about__cert-detail {
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .about__sign {
    margin: 28px 0 0;
    font-family: var(--font-script);
    font-size: 2.4rem;
    word-spacing: 0.25em;
    line-height: 1;
    color: var(--gold-500);
  }

  @media (max-width: 900px) {
    .about__grid {
      grid-template-columns: 1fr;
    }

    .about__photo {
      margin-right: 24px;
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-cert-dialog]');
  if (dialog && typeof dialog.showModal === 'function') {
    const img = dialog.querySelector<HTMLImageElement>('[data-cert-img]')!;
    document.querySelectorAll<HTMLAnchorElement>('[data-cert]').forEach((link) =>
      link.addEventListener('click', (e) => {
        e.preventDefault();
        img.src = link.href;
        img.alt = link.querySelector('img')?.alt ?? '';
        dialog.showModal();
      })
    );
    dialog.querySelector('[data-cert-close]')!.addEventListener('click', () => dialog.close());
    // klik mimo obrázek zavře náhled
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>
