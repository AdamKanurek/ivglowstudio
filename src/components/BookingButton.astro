---
/**
 * Jediné místo pro CTA „Objednat se“.
 * Dnes vede na sekci Kontakt; po zavedení rezervačního systému stačí změnit `booking.href`
 * v src/data/site.ts (případně sem vložit widget/modal).
 */
import { booking, section } from '../data/site';

interface Props {
  variant?: 'primary' | 'ghost';
  class?: string;
}

const { variant = 'primary', class: className } = Astro.props;
const external = booking.href.startsWith('http');
// odkaz na sekci (#kontakt) musí fungovat i z podstránek
const href = booking.href.startsWith('#') ? section(booking.href) : booking.href;
---

<a
  href={href}
  class:list={['btn', `btn--${variant}`, className]}
  {...external ? { target: '_blank', rel: 'noopener' } : {}}
>
  {booking.label}
</a>
