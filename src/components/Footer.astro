---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { site, legal } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <Image src={logo} alt={site.name} width={150} densities={[1, 2]} class="footer__logo" />
    <p>
      {site.address.street}, {site.address.zip} {site.address.city} ·
      <a href={site.phoneHref}>{site.phone}</a> ·
      <a href={site.instagramUrl} target="_blank" rel="noopener">{site.instagram}</a> ·
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </p>
    <p class="footer__legal">
      Provozovatel: {legal.name} · IČO {legal.ico} · sídlo {legal.seat} · {legal.register}
    </p>
    <p class="footer__legal">
      Mimosoudní řešení spotřebitelských sporů: Česká obchodní inspekce,
      <a href="https://adr.coi.cz" target="_blank" rel="noopener">adr.coi.cz</a>
    </p>
    <p class="footer__copy">© {year} {site.name}</p>
  </div>
</footer>

<style>
  .footer {
    padding-block: 56px 40px;
    background: var(--bg-alt);
    border-top: 1px solid var(--line);
    text-align: center;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .footer :global(.footer__logo) {
    width: 150px;
    margin-bottom: 12px;
  }

  .footer a {
    text-decoration: none;
    color: var(--gold-900);
  }

  .footer a:hover {
    color: var(--gold-500);
  }

  .footer p {
    margin: 0;
  }

  .footer__legal {
    max-width: 44rem;
    font-size: 0.8rem;
    line-height: 1.6;
  }

  .footer__copy {
    font-size: 0.8rem;
    letter-spacing: 0.06em;
  }
</style>
