---
import '../styles/global.css';
import { site } from '../data/site';
import { treatments, extras } from '../data/services';
import { getImage } from 'astro:assets';
import ogSource from '../assets/img/IVglow67.jpg';

const og = await getImage({ src: ogSource, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const canonical = new URL(Astro.url.pathname, Astro.site);
// cesty k souborům z public/ musí respektovat base (na GitHub Pages web běží v podsložce)
const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// náhledová verze (GitHub Pages) nemá být ve vyhledávačích
const noindex = process.env.NOINDEX === 'true';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BeautySalon',
  name: site.name,
  description: site.description,
  url: Astro.site?.toString(),
  telephone: site.phoneHref.replace('tel:', ''),
  image: new URL(og.src, Astro.site).toString(),
  sameAs: [site.instagramUrl],
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    postalCode: site.address.zip,
    addressCountry: site.address.country,
  },
  priceRange: '100 – 1700 Kč',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Ceník služeb',
    itemListElement: [...treatments.filter((s) => !s.addon), ...extras].map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.name },
      price: s.price,
      priceCurrency: 'CZK',
    })),
  },
};
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={`${baseUrl}favicon.png`} />
    <link rel="sitemap" href={`${baseUrl}sitemap-index.xml`} />
    <meta name="theme-color" content="#fdfbf8" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(og.src, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <slot />

    <script>
      // Jemné objevování sekcí při scrollu
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px' }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
